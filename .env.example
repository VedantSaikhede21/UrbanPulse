# ─────────────────────────────────────────────────────────────
#  UrbanPulse — Single source of truth for Docker deployment
#  Copy this file to `.env` and fill in real values.
#  `.env` is gitignored — never commit it.
#
#  docker compose up --build   ← one command, Windows or Linux
# ─────────────────────────────────────────────────────────────

# ── Backend runtime (passed to the backend container) ─────────
# Required
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# REQUIRED for production auth. Without it every authenticated
# request returns 500. Get it from Supabase → Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# Set to "production" for the demo. The compose file forces ENV=production.
ENV=production

# AI (optional — rule-based fallback when absent)
GEMINI_API_KEY=your-gemini-api-key

# Notifications (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Comma-separated allowed CORS origins (frontend is same-origin via
# nginx proxy, so this is a safety net, not a requirement)
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ── Frontend build args (baked into the bundle at BUILD time) ──
# VITE_* vars can never be changed at runtime — they are inlined by Vite.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Leave empty for same-origin (nginx proxies /api → backend).
# Set to an absolute URL only if the frontend talks to a remote API.
VITE_API_URL=

# ── Compose only (host port mapping) ──────────────────────────
# Change these if port 80 or 8000 is busy on the host
# (e.g. IIS/Skype on Windows, or another dev server).
BACKEND_PORT=8000
FRONTEND_PORT=80

# ── Optional: local PostGIS database for fully offline demos ──
# Enable with: docker compose --profile local-db up --build
# Then override DATABASE_URL to:
#   DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres
