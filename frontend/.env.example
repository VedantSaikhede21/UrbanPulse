# Frontend — copy to frontend/.env (must match backend Supabase project)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Leave EMPTY. Both runtimes proxy /api to the backend on the same origin:
# the Vite dev server (vite.config.ts -> server.proxy) and nginx in Docker
# and in production. Setting this to http://localhost:8000 makes the browser
# call the visitor's own machine and every request is blocked by the
# same-origin CSP, so the app silently loses all data. src/lib/api.ts also
# ignores a loopback value whenever the page is not itself on loopback.
VITE_API_URL=

# Optional CARTO raster basemap key. Leave empty to use OpenStreetMap.
VITE_CARTO_API_KEY=

# Sentry (Phase 3 observability). When VITE_SENTRY_DSN is unset,
# main.tsx skips init entirely — no network call goes out, no
# error in dev. Set the DSN in staging / production deploys only.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
